{
  "_comment": "Daily price-move screens. window: 1d | 1w | 1m | 3m | 6m | 1y | earn (since the close before the last earnings report). direction: up | down | either. threshold_pct is a positive magnitude.",
  "rules": [
    {
      "id": "daily-mover",
      "label": "Moved 4%+ today",
      "window": "1d",
      "threshold_pct": 4,
      "direction": "either"
    },
    {
      "id": "weekly-breakout",
      "label": "Up 10%+ over the week",
      "window": "1w",
      "threshold_pct": 10,
      "direction": "up"
    },
    {
      "id": "monthly-slide",
      "label": "Down 15%+ over the month",
      "window": "1m",
      "threshold_pct": 15,
      "direction": "down"
    },
    {
      "id": "post-earnings-pop",
      "label": "Up 10%+ since last earnings",
      "window": "earn",
      "threshold_pct": 10,
      "direction": "up"
    }
  ]
}
